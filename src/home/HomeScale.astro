---
// 首页的每一屏是 1440×900 的画布，按页面宽度整体等比缩放（Screen.astro 读 --home-scale）。
// 这段脚本算「页面宽度 ÷ 1440」。放在 <head> 里、内联：<HomeScale slot="head" />，
// 这样第一帧画出来之前比例就算好了，不会先按原尺寸闪一下。
---

<script is:inline>
  (function () {
    const root = document.documentElement;
    const fit = function () {
      root.style.setProperty('--home-scale', String(root.clientWidth / 1440));
    };
    fit();
    // 页面宽度变了（改窗口大小、滚动条出现）就重算
    if ('ResizeObserver' in window) new ResizeObserver(fit).observe(root);
    else window.addEventListener('resize', fit);
  })();
</script>
