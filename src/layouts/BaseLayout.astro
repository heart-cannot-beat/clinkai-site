---
// 全站页面外壳：自托管字体、设计规范变量、基础样式，每个页面的标题、描述和分享卡片，
// 以及访问统计的那一小段脚本（P-06）。
// 字体只有 Inter Tight 400（经 npm 打包，按 unicode-range 分包按需下载）；
// 中文不加载网络字体，按 tokens.css 的字体栈落到系统字体。
import '@fontsource/inter-tight/400.css';
import '../styles/tokens.css';
import '../styles/base.css';
import { canonicalPath, canonicalUrl } from '../seo/meta';
import {
  absoluteUrl,
  DEFAULT_DESCRIPTION,
  SHARE_IMAGE,
  SITE_LOCALE,
  SITE_NAME,
} from '../seo/site';

interface Props {
  title: string;
  /**
   * 这一页的描述，显示在搜索结果和分享卡片上。文案照抄 design/copy.md，不要自己写；
   * 不传时用首屏的那一句（src/seo/site.ts）。
   */
  description?: string;
  /** 不希望被搜索引擎收录的页面（比如部件陈列页）设为 true：不进站点地图，robots.txt 里也不让抓 */
  noindex?: boolean;
}

const {
  title,
  description = DEFAULT_DESCRIPTION,
  noindex = false,
} = Astro.props;

// 不收录的页面不写 canonical 和 og:url；404 页也是这一类，它没有固定的地址
const canonical = noindex ? null : canonicalUrl(Astro.url.pathname);
const shareImage = absoluteUrl(SHARE_IMAGE.path);

// 访问统计记的页面路径：构建时定下来写在页面上，不取地址栏里的地址。
// 所以 404 页不管在哪个地址下打开，记的都是 /404/；查询串也不会被记进去。
const visitPath = canonicalPath(Astro.url.pathname);
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {canonical && <link rel="canonical" href={canonical} />}

    {/* 分享卡片：Open Graph（微信、领英等）和 Twitter Card。全站共用一张分享图 */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content={SITE_LOCALE} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content={String(SHARE_IMAGE.width)} />
    <meta property="og:image:height" content={String(SHARE_IMAGE.height)} />
    <meta property="og:image:alt" content={SHARE_IMAGE.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImage} />

    {/* 个别页面要在画出第一帧之前跑的小段内联脚本（比如首页算画布的缩放比例） */}
    <slot name="head" />
  </head>
  <body data-visit-path={visitPath}>
    <slot />
  </body>
</html>

<script>
  // 访问统计：页面打开时往自己的 /api/visit 发一条（src/visit/report.ts，说明见 docs/analytics.md）。
  // 这段脚本打包进站点，不加载任何外部代码。
  import { reportVisit } from '../visit/report';

  reportVisit();
</script>
