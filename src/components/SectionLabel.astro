---
// 小节标签：一个 8px 圆点加「04 / 达人营销」这样的文字，15px。03b 以外的内容屏。
// 位置每屏不同，由所在的屏决定；颜色跟随所在位置的文字颜色。
interface Props {
  /** 设计稿里 04 屏用 h2，06 屏用 p */
  as?: 'h2' | 'h3' | 'p';
}

const { as: Tag = 'p' } = Astro.props;
---

<Tag class="section-label">
  <span class="dot" aria-hidden="true"></span>
  <slot />
</Tag>

<style>
  .section-label {
    margin: 0;
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: var(--text-body);
    font-weight: var(--weight);
  }

  .dot {
    flex: none;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: currentColor;
  }
</style>
