---
// 单行输入框：标签在上、输入框在下。品牌名、官网或店铺链接、怎么联系你。
// 最下面一行是放错误提示的位置，平时藏着，由提交脚本（src/contact/form.ts）填。
import '../../styles/form.css';

interface Props {
  label: string;
  name: string;
  type?: 'text' | 'url' | 'email' | 'tel';
  placeholder?: string;
  required?: boolean;
  maxlength?: number;
  autocomplete?: string;
}

const {
  label,
  name,
  type = 'text',
  placeholder,
  required,
  maxlength,
  autocomplete,
} = Astro.props;
---

<label class="field" data-field={name}>
  <span class="field-label">{label}</span>
  <input
    class="field-control"
    type={type}
    name={name}
    placeholder={placeholder}
    required={required}
    maxlength={maxlength}
    autocomplete={autocomplete}
    aria-describedby={`${name}-error`}
  />
  <span
    class="field-error"
    id={`${name}-error`}
    data-error-for={name}
    hidden
  ></span>
</label>
