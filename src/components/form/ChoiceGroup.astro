---
// 多选胶囊：想去的市场、需要哪些服务。每个选项是一个带复选框的胶囊，可以多选。
// 最下面一行是放错误提示的位置，平时藏着，由提交脚本（src/contact/form.ts）填。
import '../../styles/form.css';

interface Props {
  legend: string;
  name: string;
  options: readonly string[];
}

const { legend, name, options } = Astro.props;
---

<fieldset
  class="choice-group"
  data-field={name}
  aria-describedby={`${name}-error`}
>
  <legend>{legend}</legend>
  <div class="choices">
    {options.map((option) => (
      <label class="choice">
        <input type="checkbox" name={name} value={option} />
        {option}
      </label>
    ))}
  </div>
  <span
    class="field-error"
    id={`${name}-error`}
    data-error-for={name}
    hidden
  ></span>
</fieldset>

<style>
  .choice-group {
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  legend {
    padding: 0;
    margin-bottom: 8px;
    font-size: var(--text-nav);
    color: var(--muted);
  }

  .choices {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .choice {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 40px;
    padding: 0 14px;
    border-radius: var(--radius-pill);
    border: 1px solid rgba(28, 28, 27, 0.3);
    font-size: var(--text-small);
    cursor: pointer;
  }

  /* 暂定（Issue #15 第 8 问）：出错时描边换成实色墨色 */
  .choice-group[data-invalid] .choice {
    border-color: var(--ink);
  }

  input {
    margin: 0;
    accent-color: var(--ink);
  }
</style>
