---
// 右下角「SCROLL ↓」，在菜单按钮左边。只在 01、04、05 屏出现（design/README.md）。
import { SCROLL_HINT } from '../data/site';

interface Props {
  tone?: 'ink' | 'paper';
  /** 同一页里重复出现的那几个：对读屏软件隐藏 */
  decorative?: boolean;
}

const { tone = 'ink', decorative = false } = Astro.props;
---

<span
  class:list={['scroll-hint', tone]}
  aria-hidden={decorative ? 'true' : undefined}
>
  {SCROLL_HINT}
</span>

<style>
  .scroll-hint {
    position: absolute;
    right: 104px;
    bottom: 44px;
    font-size: var(--text-nav);
    letter-spacing: 0.04em;
    z-index: var(--z-chrome);
  }

  .ink {
    color: var(--ink);
  }

  .paper {
    color: var(--paper);
  }
</style>
