---
// 页头。两种样子，见 design/README.md「公共部件」：
// - plain（普通）：标志和导航直接压在底色上。01、04、05、06 屏和子页面。
//   深色底（04 屏）用 tone="paper"，文字和描边换成纸色。
// - pill（浅色胶囊）：背后是图片，标志和导航各自放在浅色胶囊里，「预约沟通」是深色实心。02、03、03b 屏。
// 位置照设计稿：贴着所在画面（最近的 position: relative 祖先）的顶部。
// 首页静态版每一屏的画面里都有页头：只有第一屏的是真页头，其余几屏的加 decorative，
// 对读屏软件隐藏、不进键盘的 Tab 顺序（鼠标照样能点），免得同一组导航被念七遍。
import {
  CONTACT_CTA,
  HOME_HREF,
  LOGO_LABEL,
  LOGO_TEXT,
  NAV_ITEMS,
  type NavKey,
} from '../data/site';

interface Props {
  variant?: 'plain' | 'pill';
  /** 只对 plain 有效：ink 是纸色底上的墨色字，paper 是深色底上的纸色字 */
  tone?: 'ink' | 'paper';
  /** 当前所在的页面：导航项加下划线；contact 时标在「预约沟通」上 */
  current?: NavKey | 'contact';
  /** 同一页里重复出现的页头：对读屏软件隐藏，不进 Tab 顺序 */
  decorative?: boolean;
}

const {
  variant = 'plain',
  tone = 'ink',
  current,
  decorative = false,
} = Astro.props;
const pageCurrent = (key: string) => (current === key ? 'page' : undefined);
const tabindex = decorative ? -1 : undefined;
---

<header
  class:list={['site-header', variant, variant === 'plain' && tone]}
  aria-hidden={decorative ? 'true' : undefined}
>
  <a class="logo" href={HOME_HREF} aria-label={LOGO_LABEL} tabindex={tabindex}>
    <span>{LOGO_TEXT}</span>
    <span class="logo-dot" aria-hidden="true"></span>
  </a>
  <nav class="nav">
    {NAV_ITEMS.map((item) => (
      <a
        class="nav-link"
        href={item.href}
        aria-current={pageCurrent(item.key)}
        tabindex={tabindex}
      >
        {item.label}
      </a>
    ))}
    <a
      class="cta"
      href={CONTACT_CTA.href}
      aria-current={pageCurrent('contact')}
      tabindex={tabindex}
    >
      {CONTACT_CTA.label}
      <span aria-hidden="true">{CONTACT_CTA.arrow}</span>
    </a>
  </nav>
</header>

<style>
  .site-header {
    position: absolute;
    display: flex;
    align-items: center;
    justify-content: space-between;
    z-index: var(--z-header);
  }

  .logo {
    display: flex;
    align-items: baseline;
    gap: 3px;
    letter-spacing: -0.01em;
  }

  .logo-dot {
    border-radius: 50%;
    background: currentColor;
  }

  .nav {
    display: flex;
    align-items: center;
    font-size: var(--text-nav);
    letter-spacing: 0.02em;
  }

  .nav-link[aria-current='page'] {
    text-decoration: underline;
    text-underline-offset: 5px;
  }

  .cta {
    display: flex;
    gap: 8px;
    align-items: center;
    border-radius: var(--radius-pill);
  }

  /* ---------- 普通 ---------- */
  .plain {
    left: var(--page-margin);
    right: var(--page-margin);
    top: var(--header-top);
  }

  .plain .logo {
    font-size: var(--text-logo);
  }

  .plain .logo-dot {
    width: 9px;
    height: 9px;
  }

  .plain .nav {
    gap: 28px;
  }

  .plain .cta {
    padding: 10px 18px;
    border: 1px solid var(--outline-button);
  }

  .plain.ink {
    color: var(--ink);
  }

  /* 深色底（04 屏）：文字纸色，按钮描边是纸色的 40% */
  .plain.paper {
    color: var(--paper);
  }

  .plain.paper .cta {
    border-color: rgba(230, 228, 223, 0.4);
  }

  /* ---------- 浅色胶囊 ---------- */
  .pill {
    left: 20px;
    right: 20px;
    top: 18px;
    color: var(--ink);
  }

  .pill .logo {
    padding: 8px 16px;
    font-size: 22px;
    background: var(--paper);
    border-radius: var(--radius-pill);
  }

  .pill .logo-dot {
    width: 8px;
    height: 8px;
  }

  .pill .nav {
    gap: 24px;
    padding: 6px 6px 6px 22px;
    background: var(--paper);
    border-radius: var(--radius-pill);
  }

  .pill .cta {
    padding: 9px 16px;
    background: var(--ink);
    color: var(--paper);
  }
</style>
